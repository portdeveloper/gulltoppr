{
  "name": "gulltoppr-engine",
  "version": "0.1.0",
  "private": true,
  "description": "gulltoppr engine: resolution ladder + verb surface (resolve_abi, read, encode, simulate, prepare_tx, decode_tx, resolve_name) that lets agents interact with any contract on any EVM chain. See ../SPEC.md.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "mcp": "tsx src/mcp.ts",
    "mcp:http": "tsx src/mcp-http.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "RUN_LIVE_CONTRACT_TESTS=1 vitest run test/liveContracts.test.ts",
    "build:sdk": "npm --prefix sdk run build",
    "test:sdk": "npm --prefix sdk test",
    "test:sdk:dist": "node scripts/sdk-dist-smoke.mjs",
    "audit": "npm audit --audit-level=moderate",
    "audit:sdk": "npm --prefix sdk audit --audit-level=moderate",
    "docker:build": "docker build -t gulltoppr-engine:ci .",
    "docker:build:mcp": "docker build -f Dockerfile.mcp -t gulltoppr-mcp:ci .",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "hono": "^4.6.14",
    "tsx": "^4.19.2",
    "viem": "^2.21.55",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
